FROM ocaml/opam:debian-ocaml-4.13 AS builder

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cargo \
        git \
        libgmp-dev \
        libssl-dev \
        libz3-dev \
        make \
        m4 \
        pkg-config \
        python3 \
        python3-dev \
        rustc \
        z3 \
    && rm -rf /var/lib/apt/lists/*

USER opam
WORKDIR /home/opam

RUN git clone -b enfflash https://github.com/runtime-enforcement/whyenf.git whyenf
WORKDIR /home/opam/whyenf

RUN opam update \
    && opam install -y \
        dune \
        core_unix \
        menhir=20250912 \
        xml-light \
        ppx_jane \
        calendar \
        z3 \
        pyml=20250807 \
        alcotest \
    && eval $(opam env) \
    && make build

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgmp10 \
        libssl3t64 \
        libz3-4 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /home/opam/whyenf/bin/enfflash.exe /opt/whyenf/enfguard
COPY --from=builder /home/opam/whyenf/enfflash/target/release/enfflash /usr/local/bin/enfflash
RUN chmod +x /opt/whyenf/enfguard /usr/local/bin/enfflash

ENTRYPOINT ["/opt/whyenf/enfguard"]