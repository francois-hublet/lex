<owl:Ontology rdf:about="https://lex-lang.org/ontology/gdpr">
  <rdfs:comment>Declarations of the Lex program gdpr.lex. Generated by the Lex compiler.</rdfs:comment>
</owl:Ontology>

<owl:Class rdf:about="https://lex-lang.org/ontology/core#Declaration">
  <rdfs:label>Declaration</rdfs:label>
  <rdfs:comment>An instance of a relation declared by the Lex program.</rdfs:comment>
</owl:Class>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#baseType">
  <rdfs:label>baseType</rdfs:label>
  <rdfs:comment>The atomic Lex type the values of a type are written as.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#enforcementType">
  <rdfs:label>enforcementType</rdfs:label>
  <rdfs:comment>The enforcement type of a Lex declaration.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#external">
  <rdfs:label>external</rdfs:label>
  <rdfs:comment>Whether the declaration is external in Lex.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#internal">
  <rdfs:label>internal</rdfs:label>
  <rdfs:comment>Whether the declaration is internal in Lex.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#argumentIndex">
  <rdfs:label>argumentIndex</rdfs:label>
  <rdfs:comment>The position of an argument in a Lex declaration.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#isValue">
  <rdfs:label>isValue</rdfs:label>
  <rdfs:comment>Whether the argument is the value of a functional or variable declaration.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://lex-lang.org/ontology/core#type">
  <rdfs:label>type</rdfs:label>
  <rdfs:comment>The Lex type of an argument or field.</rdfs:comment>
</owl:AnnotationProperty>

