       affecting the lawfulness of processing based on consent before its withdrawal</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>causable observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#IsRightToWithdrawConsent_de"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

