  <lex:argumentIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</lex:argumentIndex>
</owl:ObjectProperty>

<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#AssessTransfer">
