<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#AutomatedDecision">
  <rdfs:label>AutomatedDecision</rdfs:label>
  <rdfs:comment>Activity {a} uses data {d} for automated decision-making, including profiling, with respect to data subject {ds},
       with meaningful information about the logic involved, as well as the significance and the envisaged consequences
       of such processing for the data subject, declared in {de}</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AutomatedDecision_a"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AutomatedDecision_d"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AutomatedDecision_ds"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AutomatedDecision_de"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:ObjectProperty rdf:about="https://lex-lang.org/ontology/gdpr#AutomatedDecision_a">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
