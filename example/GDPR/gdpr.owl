<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#AuthorizeConsent">
  <rdfs:label>AuthorizeConsent</rdfs:label>
  <rdfs:comment>The data subject {ds} authorizes data subject {ds'} to give consent on their behalf to processor {c} for purpose {p}</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AuthorizeConsent_ds"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AuthorizeConsent_ds_"/>
