<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#CanDelayInform">
  <rdfs:label>CanDelayInform</rdfs:label>
  <rdfs:comment>Controller {c} can delay informing data subject {ds} about the collection activity {a}</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>internal</lex:enforcementType>
  <lex:internal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</lex:internal>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#CanDelayInform_c"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
