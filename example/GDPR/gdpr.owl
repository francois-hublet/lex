<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#IsSpecialData">
  <rdfs:label>IsSpecialData</rdfs:label>
  <rdfs:comment>The data {d} reveals information of special data category {sp}.
       Special data categories include personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs,
       trade union membership, the processing of genetic data, biometric data for the purpose of uniquely identifying a natural person,
       data concerning health or data concerning a natural person's sex life or sexual orientation</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
