  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label>ds</rdfs:label>
  <rdfs:domain rdf:resource="https://lex-lang.org/ontology/gdpr#GiveConsent"/>
  <rdfs:range rdf:resource="https://lex-lang.org/ontology/gdpr#data_subject"/>
  <lex:type>data_subject</lex:type>
  <lex:argumentIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</lex:argumentIndex>
</owl:ObjectProperty>

