<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#AdequacyDecision">
  <rdfs:label>AdequacyDecision</rdfs:label>
  <rdfs:comment>Country or international organisation {co} is subject to an adequacy decision by the Commission.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#AdequacyDecision_co"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

