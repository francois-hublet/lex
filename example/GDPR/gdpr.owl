<owl:Class rdf:about="https://lex-lang.org/ontology/gdpr#IsRights">
  <rdfs:label>IsRights</rdfs:label>
  <rdfs:comment>Declaration {de} declares the existence of the right to request from the controller access 
       to and rectification or erasure of personal data or restriction of processing concerning 
       the data subject or to object to processing as well as the right to data portability.
       The right to object (Article 21(1-2)) referred shall be explicitly brought to the attention 
       of the data subject and shall be presented clearly and separately from any other information.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>causable observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#IsRights_de"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

