  <rdfs:label>IsNecessaryForSpecialMedicalReasons</rdfs:label>
  <rdfs:comment>Processing activity {a} is necessary for the purposes of preventive or occupational medicine, 
       for the assessment of the working capacity of the employee, medical diagnosis, the provision
       of health or social care or treatment or the management of health or social care systems and 
       services on the basis of Union or Member State law or pursuant to contract with a health professional</rdfs:comment>
  <rdfs:subClassOf rdf:resource="https://lex-lang.org/ontology/core#Declaration"/>
  <lex:enforcementType>observable</lex:enforcementType>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://lex-lang.org/ontology/gdpr#IsNecessaryForSpecialMedicalReasons_a"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

